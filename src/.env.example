# Line Bot
LINE_CHANNEL_SECRET=你的Channel_Secret
LINE_CHANNEL_ACCESS_TOKEN=你的Channel_Access_Token

# Google Gemini API（免費，無需信用卡）
# 申請網址：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=你的Gemini_API_Key

# 財政部電子發票（申請後填入，目前可留空）
EINVOICE_APP_ID=
EINVOICE_API_KEY=

# Supabase
SUPABASE_URL=你的Project_URL
SUPABASE_KEY=你的anon_Key

# 匯率 API（免費申請：https://www.exchangerate-api.com/）
EXCHANGE_RATE_API_KEY=你的ExchangeRate_API_Key

PORT=3000
NODE_ENV=development
