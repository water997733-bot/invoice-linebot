# ==============================
# Line Bot 設定
# ==============================
LINE_CHANNEL_SECRET=你的_Channel_Secret
LINE_CHANNEL_ACCESS_TOKEN=你的_Channel_Access_Token

# ==============================
# Google Gemini API（免費）
# 申請：https://aistudio.google.com/app/apikey
# ==============================
GEMINI_API_KEY=你的_Gemini_API_Key

# ==============================
# 匯率 API（免費，選填）
# 申請：https://www.exchangerate-api.com/
# 不填則使用內建備用匯率
# ==============================
EXCHANGE_RATE_API_KEY=你的_ExchangeRate_API_Key

# ==============================
# 財政部電子發票 API（選填）
# ==============================
EINVOICE_APP_ID=你的_AppID
EINVOICE_API_KEY=你的_API_Key

# ==============================
# Supabase 資料庫
# ==============================
SUPABASE_URL=https://你的專案.supabase.co
SUPABASE_KEY=你的_anon_public_key

# ==============================
# 伺服器設定（Railway 會自動設定 PORT，不用填）
# ==============================
NODE_ENV=production
